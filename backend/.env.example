# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database ---
DATABASE_URL=sqlite:///./xyz_ai.db

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string

# --- AI provider (optional) ---
# If left blank, XYZ AI runs in built-in "demo mode": a deterministic rule-based
# intent engine handles the required demo scenarios with zero external calls.
# Set this to enable real LLM-based natural language understanding via the
# Anthropic Messages API (tool-calling), used the same way in both modes so the
# permission engine sees identical structured tool requests either way.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Voice (optional) ---
# Left blank -> frontend falls back to the browser's built-in Web Speech API
# (SpeechRecognition / SpeechSynthesis), which needs no key at all.
TTS_API_KEY=
